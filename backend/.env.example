# Copiá este archivo a ".env" y completá con tus valores reales.
# ".env" está en .gitignore — nunca se sube.

# En Render: Dashboard > nova-db > Connect > Internal Database URL
DATABASE_URL=postgres://usuario:password@host/dbname

# Cualquier cadena larga y random. Se usa para firmar los tokens de login.
JWT_SECRET=cambiar-esto-por-algo-largo-y-random

# Dominio del frontend (Hostinger) que puede llamar a esta API
CORS_ORIGIN=http://localhost:8731

PORT=3000
